# Optional, but recommended for US public companies. The SEC requires a real,
# identifying User-Agent containing your organization/name and contact email.
# Export this in your shell; this file is an example, not automatically loaded.
SEC_USER_AGENT="Your Name research@example.com"

# Optional hosting settings; see README.md. Values below show the defaults.
# For a paid Render disk mounted at /var/data, set this to /var/data/reports.
# STOCK_CRAWLER_REPORT_DIR=reports
# STOCK_CRAWLER_JOB_RETENTION_HOURS=168
# STOCK_CRAWLER_REPORTS_PER_HOUR=240  # Global accepted-job cap; 0 disables.
# STOCK_CRAWLER_MAX_ACTIVE_REPORTS=12
# STOCK_CRAWLER_REPORT_WORKERS=2
# To enable optional HTTP Basic authentication, set a strong secret in your
# host's environment (not in this tracked file), and optionally set the user.
# STOCK_CRAWLER_AUTH_USER=researcher
# STOCK_CRAWLER_AUTH_PASSWORD=  # Generate and set privately; HTTPS required.
